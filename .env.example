# Copy this file to ".env" and fill in your values. ".env" is git-ignored.
# Keep comments on their own lines and values unquoted.

# --- Keys and endpoints ---
# JEV is reached through KodeKey (the KodeKloud AI gateway).
KODEKEY_BASE_URL=https://api.ai.kodekloud.com/v1
KODEKEY_API_KEY=

# Azure AI Foundry: one RESOURCE endpoint and one key cover every deployment on the resource.
# Use the resource endpoint, not the project endpoint (.../api/projects/<name>): API keys are scoped to the resource.
FOUNDRY_ENDPOINT=https://<resource-name>.services.ai.azure.com
FOUNDRY_API_KEY=

# --- Default line-up for desks 1, 2 and 3 (profile names from the section below, comma separated) ---
# In the game, the Setup tab can seat any profile below at any desk.
LINEUP=JEV,DECISION1,GPT41MINI

# --- Model profiles ---
# Paste the URL exactly as the Foundry portal shows it. Its ending selects the API:
#   .../openai/v1/responses                -> Responses API
#   .../openai/v1/chat/completions         -> Chat Completions
#   .../providers/microsoft/v1/systemone   -> Microsoft Decision 1
# MODEL is the deployment name shown in the portal, not the model name.
# JEV via KodeKey. "npm run check" lists the exact model id your token may use.
MODEL_JEV_LABEL=JEV
MODEL_JEV_PROVIDER=kodekey
MODEL_JEV_MODEL=typesafe/jev-1.13.0

MODEL_DECISION1_LABEL=Decision 1
MODEL_DECISION1_URL=https://<resource-name>.services.ai.azure.com/providers/microsoft/v1/systemone
MODEL_DECISION1_MODEL=

MODEL_GPT41MINI_LABEL=GPT-4.1 mini
MODEL_GPT41MINI_URL=https://<resource-name>.services.ai.azure.com/openai/v1/responses
MODEL_GPT41MINI_MODEL=gpt-4.1-mini

MODEL_GPT41_LABEL=GPT-4.1
MODEL_GPT41_URL=https://<resource-name>.services.ai.azure.com/openai/v1/responses
MODEL_GPT41_MODEL=gpt-4.1

MODEL_GROK47_LABEL=Grok 4.7
MODEL_GROK47_URL=https://<resource-name>.services.ai.azure.com/openai/v1/chat/completions
MODEL_GROK47_MODEL=grok-4.7
# Grok reasons at "high" by default; "low" is much faster for a one-word answer.
# MODEL_GROK47_REASONING_EFFORT=low

# Optional per profile (replace <NAME> with the profile name):
#   MODEL_<NAME>_REASONING_EFFORT=low|medium|high
#   MODEL_<NAME>_TEMPERATURE=0
#   MODEL_<NAME>_MAX_TOKENS=4096
#   MODEL_<NAME>_PRICE_IN=0.20    (USD per 1M input tokens)
#   MODEL_<NAME>_PRICE_OUT=0.80
#   MODEL_<NAME>_PRICE_CACHED_IN=0.05    (USD per 1M cached input tokens; charged as normal input when left out)
#   MODEL_<NAME>_API=auto|chat|responses    (only when no URL is given)
#   MODEL_<NAME>_MODE=auto|questions|systemone    (System One models only)
# Cost works out of the box for JEV, Decision 1, GPT-4.1, GPT-4.1 mini and Grok 4.7 (built-in list prices, see
# docs/setup.md). Set the PRICE variables to override them or to price any other model.

# --- Optional ---
PORT=3000
HOST=127.0.0.1
MOCK_MODE=false
REQUEST_TIMEOUT_MS=60000
MAX_RETRIES=2

# Older style, still supported when LINEUP is empty: DESK1_*, DESK2_*, DESK3_* with the same settings as a profile.

# --- Anonymous race usage control (public hosted demo only; leave disabled for local/default use) ---
# Disabled by default: the app behaves exactly as before and never needs Azure. Enable this only for a
# public deployment, where it limits every anonymous visitor to USAGE_VISITOR_DAILY_LIMIT race starts (10 by default)
# per Asia/Kolkata day and
# stops new races once the app-wide daily cap below is reached. See docs/setup.md#3-run-it-as-a-protected-public-demo
# for the full walkthrough (Azure prerequisites, rollout, rollback, retention, cost alerts).
USAGE_CONTROL_ENABLED=false
# Required, non-negative integer, when the above is true. 0 is a valid emergency stop (refuses every race).
# Size it from the worst case: 50 applicants x 3 desks = 150 decisions, each retried up to MAX_RETRIES times
# (up to 6 provider attempts), so up to 900 provider attempts per race plus a few preparation probes. A lower
# value here takes effect immediately (even mid-day); a higher value only takes effect the next India day.
USAGE_DAILY_GLOBAL_RACES=
# Race starts each anonymous visitor (browser) gets per India day: a whole number from 1 to 1000, default 10.
# A change applies from the next race start after a restart, up or down; the global cap above still bounds
# everyone combined.
USAGE_VISITOR_DAILY_LIMIT=10
# Required in production: the Azure Table service endpoint, e.g. https://<account>.table.core.windows.net
# App Service authenticates to it with its managed identity (Storage Table Data Contributor on the table);
# no storage key or connection string is used there.
USAGE_TABLE_ENDPOINT=
USAGE_TABLE_NAME=RaceUsage
# Local-development-only alternative to USAGE_TABLE_ENDPOINT (e.g. an Azurite connection string).
# Rejected at startup when App Service environment markers are present. Give local runs their own
# USAGE_TABLE_NAME: every process that shares a table shares its daily counters and its lowest daily cap.
USAGE_STORAGE_CONNECTION_STRING=
# Required, stable secret for the visitor cookie and day-scoped hashes. Rotate only at India midnight or
# during a maintenance window: rotating it mid-day invalidates visitor cookies and active race permits.
USAGE_SIGNING_SECRET=
# Minutes a race permit stays valid (capped at the next India midnight too), 1-180.
USAGE_PERMIT_MINUTES=45
# Best-effort per-IP race-start burst limit per minute, 1-1000; a secondary speed bump, not the authority.
USAGE_STARTS_PER_MINUTE=6
